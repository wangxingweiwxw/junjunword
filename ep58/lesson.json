 "script": [
  {
   "cue": [
    "title"
   ],
   "parts": [
    {
     "zh": "小朋友们好！还记得第三十九集的情绪吗？今天，我们学更多表达感受的单词。"
    },
    {
     "en": "feelings"
    }
   ]
  },
  {
   "cue": [
    "map",
    "show:feelings",
    "focus:feelings"
   ],
   "parts": [
    {
     "zh": "心里的各种感受："
    },
    {
     "en": "feelings"
    }
   ]
  },
  {
   "cue": [
    "show:enjoy",
    "focus:enjoy"
   ],
   "parts": [
    {
     "zh": "开开心心地享受一件事："
    },
    {
     "en": "enjoy"
    },
    {
     "en": "I enjoy the sunshine at the beach."
    }
   ]
  },
  {
   "cue": [
    "show:comfortable",
    "focus:comfortable"
   ],
   "parts": [
    {
     "zh": "躺在软软的沙发上，真舒服："
    },
    {
     "en": "comfortable"
    },
    {
     "zh": "这个词很长，中间的 or 读得很轻："
    },
    {
     "en": "com, fort, able"
    }
   ]
  },
  {
   "cue": [
    "show:pleasant",
    "edge:enjoy>pleasant",
    "edge:comfortable>pleasant",
    "edge:feelings>pleasant",
    "focus:pleasant"
   ],
   "parts": [
    {
     "zh": "让人心情愉快的，是"
    },
    {
     "en": "pleasant"
    },
    {
     "en": "a pleasant day"
    }
   ]
  },
  {
   "cue": [
    "show:happiness",
    "edge:feelings>happiness",
    "focus:happiness"
   ],
   "parts": [
    {
     "zh": "开心是 happy，把 y 变成 i，加上 n e s s，就是幸福、快乐：",
     "cue": [
      "alt:happiness"
     ]
    },
    {
     "en": "happy"
    },
    {
     "en": "happiness"
    }
   ]
  },
  {
   "cue": [
    "show:unhappiness",
    "edge:happiness>unhappiness",
    "focus:unhappiness"
   ],
   "parts": [
    {
     "zh": "前面加上 u n，就是不快乐："
    },
    {
     "en": "unhappiness"
    },
    {
     "zh": "还记得第四十五集的 unusual 吗？un 让意思反过来。"
    }
   ]
  },
  {
   "cue": [
    "show:miss",
    "edge:feelings>miss",
    "focus:miss"
   ],
   "parts": [
    {
     "zh": "好久没见到奶奶了，好想她："
    },
    {
     "en": "miss"
    },
    {
     "en": "I miss my grandma."
    }
   ]
  },
  {
   "cue": [
    "show:separate",
    "edge:miss>separate",
    "focus:separate"
   ],
   "parts": [
    {
     "zh": "因为我们分开了，所以想念。分开，英语是"
    },
    {
     "en": "separate"
    }
   ]
  },
  {
   "cue": [
    "show:regret",
    "edge:feelings>regret",
    "focus:regret"
   ],
   "parts": [
    {
     "zh": "做错了事，心里很后悔："
    },
    {
     "en": "regret"
    }
   ]
  },
  {
   "cue": [
    "show:shame",
    "edge:regret>shame",
    "focus:shame"
   ],
   "parts": [
    {
     "zh": "羞愧，英语是"
    },
    {
     "en": "shame"
    },
    {
     "zh": "它也表示遗憾，比如："
    },
    {
     "en": "What a shame!"
    }
   ]
  },
  {
   "cue": [
    "show:pity",
    "edge:regret>pity",
    "focus:pity"
   ],
   "parts": [
    {
     "zh": "看到小狗淋雨，心里很同情："
    },
    {
     "en": "pity"
    },
    {
     "zh": "也可以表示可惜："
    },
    {
     "en": "What a pity!"
    }
