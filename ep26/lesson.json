 "script": [
  {
   "cue": [
    "title"
   ],
   "parts": [
    {
     "zh": "小朋友们好！过年的时候，家里来了好多亲戚。还记得第二集的家人吗？今天，我们认识更多家人。"
    },
    {
     "en": "relatives"
    }
   ]
  },
  {
   "cue": [
    "focus:none"
   ],
   "parts": [
    {
     "zh": "今天有一个小秘密：在家人的名字前面加上"
    },
    {
     "en": "grand"
    },
    {
     "zh": "就变成了长一辈，或者小一辈的家人。"
    }
   ]
  },
  {
   "cue": [
    "map",
    "show:grandfather",
    "focus:grandfather"
   ],
   "parts": [
    {
     "zh": "爸爸的爸爸，或者妈妈的爸爸，就是爷爷或外公："
    },
    {
     "en": "father"
    },
    {
     "en": "grandfather"
    },
    {
     "zh": "在家里，可以亲切地叫他",
     "cue": [
      "alt:grandfather"
     ]
    },
    {
     "en": "Grandpa"
    }
   ]
  },
  {
   "cue": [
    "show:grandmother",
    "focus:grandmother"
   ],
   "parts": [
    {
     "zh": "爸爸的妈妈，或者妈妈的妈妈，就是奶奶或外婆："
    },
    {
     "en": "mother"
    },
    {
     "en": "grandmother"
    },
    {
     "zh": "亲切地叫她",
     "cue": [
      "alt:grandmother"
     ]
    },
    {
     "en": "Grandma"
    }
   ]
  },
  {
   "cue": [
    "show:grandparents",
    "edge:grandfather>grandparents",
    "edge:grandmother>grandparents",
    "focus:grandparents"
   ],
   "parts": [
    {
     "zh": "他们两个合在一起，就是祖父母："
    },
    {
     "en": "parents"
    },
    {
     "en": "grandparents"
    }
   ]
  },
  {
   "cue": [
    "show:grandson",
    "edge:grandparents>grandson",
    "focus:grandson"
   ],
   "parts": [
    {
     "zh": "对爷爷奶奶来说，你如果是男孩，就是他们的孙子："
    },
    {
     "en": "son"
    },
    {
     "en": "grandson"
    }
   ]
  },
  {
   "cue": [
    "show:granddaughter",
    "edge:grandparents>granddaughter",
    "focus:granddaughter"
   ],
   "parts": [
    {
     "zh": "如果是女孩，就是孙女："
    },
    {
     "en": "daughter"
    },
    {
     "en": "granddaughter"
    },
    {
     "zh": "注意哦，这里有两个字母 d 连在一起。"
    }
   ]
  },
  {
   "cue": [
    "focus:grandfather,grandmother,grandson,granddaughter"
   ],
   "parts": [
    {
     "zh": "加上 grand，家人就变多啦："
    },
    {
     "en": "father, grandfather",
     "cue": [
      "focus:grandfather"
     ]
    },
    {
     "en": "mother, grandmother",
     "cue": [
      "focus:grandmother"
     ]
    },
    {
     "en": "son, grandson",
     "cue": [
      "focus:grandson"
     ]
    },
    {
     "en": "daughter, granddaughter",
     "cue": [
      "focus:granddaughter"
     ]
    }
   ]
  },
  {
   "cue": [
    "show:uncle",
    "focus:uncle"
   ],
   "parts": [
    {
     "zh": "爸爸妈妈的兄弟，叔叔、舅舅、伯伯，英语都叫"
    },
    {
     "en": "uncle"
    },
    {
     "en": "My uncle is my grandfather's son."
    }
   ]
  },
  {
   "cue": [
    "show:aunt",
    "focus:aunt"
   ],
   "parts": [
    {
     "zh": "爸爸妈妈的姐妹，姑姑、阿姨，英语都叫"
    },
    {
     "en": "aunt"
    }
   ]
  },
  {
   "cue": [
    "show:cousin",
    "edge:uncle>cousin",
    "edge:aunt>cousin",
    "focus:cousin"
   ],
   "parts": [
    {
     "zh": "叔叔阿姨家的孩子，堂哥、表妹，英语都叫"
    },
    {
     "en": "cousin"
    },
    {
     "zh": "小提示：中间的 o u，读短短的 a。"
    },
    {
     "en": "My cousin is in the car."
    }
   ]
  },
  {
   "cue": [
    "show:relative",
    "edge:cousin>relative",
    "focus:relative"
   ],
   "parts": [
    {
     "zh": "所有这些亲人，合在一起，就是亲戚："
    },
    {
     "en": "relative"
    },
    {
     "zh": "很多亲戚：",
     "cue": [
