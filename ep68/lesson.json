  },
  {
   "cue": [
    "show:spread",
    "edge:flu>spread",
    "focus:spread"
   ],
   "parts": [
    {
     "zh": "流感会传染给别人。传播，英语是"
    },
    {
     "en": "spread"
    },
    {
     "zh": "所以生病了要戴好口罩。"
    }
   ]
  },
  {
   "cue": [
    "show:medicine",
    "edge:cough>medicine",
    "focus:medicine"
