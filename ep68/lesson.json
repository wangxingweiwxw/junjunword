   "parts": [
    {
     "zh": "加上 n e s s，就是疾病："
    },
    {
     "en": "illness"
    },
    {
     "zh": "还记得 happiness 吗？一样的小尾巴。"
    }
   ]
  },
  {
   "cue": [
    "show:fever",
    "edge:sick>fever",
    "focus:fever"
   ],
   "parts": [
    {
     "zh": "身体烫烫的，是发烧："
    },
    {
     "en": "fever"
    },
    {
     "en": "I have a fever."
    }
   ]
  },
  {
   "cue": [
    "show:cough",
