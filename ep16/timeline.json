   "t1": 9.258,
   "cue": []
  },
  {
   "seg": 0,
   "lang": "zh",
   "text": "脸。",
   "t0": 9.758,
   "t1": 10.077,
   "cue": []
  },
  {
   "seg": 1,
   "lang": "zh",
   "text": "每天照镜子，看到的就是自己的脸：",
