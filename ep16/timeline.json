   "t0": 14.145,
   "t1": 14.571,
   "cue": []
  },
  {
   "seg": 1,
   "lang": "en",
   "text": "Wash your face.",
   "t0": 15.071,
   "t1": 16.124,
   "cue": []
  },
  {
   "seg": 2,
   "lang": "zh",
   "text": "脸上亮晶晶的，是眼睛：",
