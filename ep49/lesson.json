  },
  {
   "cue": [
    "show:shop",
    "edge:shop>clothes",
    "focus:shop"
   ],
   "parts": [
    {
     "zh": "我们去服装店逛一逛。商店，也可以说"
    },
    {
     "en": "shop"
    },
    {
     "en": "a clothes shop"
    }
   ]
  },
  {
