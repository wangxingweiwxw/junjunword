     "zh": "东西所在的地方，是位置、地点："
    },
    {
     "en": "location"
    }
   ]
  },
  {
   "cue": [
    "show:front",
    "edge:location>front",
    "focus:front"
   ],
   "parts": [
    {
     "zh": "箱子的前面："
