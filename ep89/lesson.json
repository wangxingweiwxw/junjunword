   "cue": [
    "show:broken",
    "edge:bone>broken",
    "focus:broken"
   ],
   "parts": [
    {
     "zh": "摔了一跤，骨头断了。还记得第七十九集的 break 吗？"
    },
    {
     "en": "break"
    },
    {
     "en": "broken"
    },
    {
     "en": "a broken arm"
