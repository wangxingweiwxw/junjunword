   "t0": 133.169,
   "t1": 133.557,
   "cue": []
  },
  {
   "seg": 12,
   "lang": "en",
   "text": "Let's call Dad!",
   "t0": 134.057,
   "t1": 135.073,
   "cue": []
  },
  {
   "seg": 13,
   "lang": "zh",
   "text": "接下来看一看，一个变成很多个的时候，这些单词会怎么变。",
   "t0": 136.173,
   "t1": 141.225,
   "cue": [
    "focus:none"
   ]
  },
  {
   "seg": 14,
   "lang": "zh",
