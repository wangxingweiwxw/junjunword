   "cue": [
    "plural:child"
   ]
  },
  {
   "seg": 16,
   "lang": "zh",
   "text": "连读音也跟着变了，要多读几遍哦。",
   "t0": 170.97,
   "t1": 173.867,
   "cue": []
  },
