   "cue": [
    "plural:family"
   ]
  },
  {
   "seg": 16,
   "lang": "zh",
   "text": "最特别的是孩子。它不加 s，而是在后面接上 r e n 三个字母。",
   "t0": 162.535,
   "t1": 168.644,
   "cue": [
    "focus:child"
