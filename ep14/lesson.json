    "focus:day"
   ],
   "parts": [
    {
     "zh": "太阳升起又落下，就是一天："
    },
    {
     "en": "day"
    },
    {
     "en": "Have a nice day!"
    }
   ]
  },
  {
   "cue": [
    "show:morning",
    "edge:day>morning",
    "focus:morning"
   ],
   "parts": [
    {
     "zh": "太阳刚刚升起，是早上："
