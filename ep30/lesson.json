 "script": [
  {
   "cue": [
    "title"
   ],
   "parts": [
    {
     "zh": "小朋友们好！嘘，你听，是什么声音？今天，我们来学音乐。"
    },
    {
     "en": "music"
    },
    {
     "zh": "音乐。"
    }
   ]
  },
  {
   "cue": [
    "map",
    "show:sound",
    "focus:sound"
   ],
   "parts": [
    {
     "zh": "耳朵听到的一切，都叫声音："
    },
    {
     "en": "sound"
    },
    {
     "en": "What's that sound?"
    }
   ]
  },
  {
   "cue": [
    "show:noise",
    "edge:sound>noise",
    "focus:noise"
   ],
   "parts": [
    {
     "zh": "吵吵闹闹、让人想捂住耳朵的声音，是噪音："
    },
    {
     "en": "noise"
    },
    {
     "zh": "加上 y，就是吵闹的：",
     "cue": [
      "alt:noise"
     ]
    },
    {
     "en": "noisy"
    }
   ]
  },
  {
   "cue": [
    "show:music",
    "edge:sound>music",
    "focus:music"
   ],
   "parts": [
    {
     "zh": "好听的、让人想跳舞的声音，是音乐："
    },
    {
     "en": "music"
    },
    {
     "en": "I love music!"
    }
   ]
  },
  {
   "cue": [
    "show:concert",
    "edge:concert>music",
    "focus:concert"
   ],
   "parts": [
    {
     "zh": "很多人一起听乐队表演，是音乐会："
    },
    {
     "en": "concert"
    }
   ]
  },
  {
   "cue": [
    "show:piano",
    "edge:concert>piano",
    "focus:piano"
   ],
   "parts": [
    {
     "zh": "音乐会上，有黑白琴键的钢琴："
    },
    {
     "en": "piano"
    }
   ]
  },
  {
   "cue": [
    "show:violin",
    "edge:concert>violin",
    "focus:violin"
   ],
   "parts": [
    {
     "zh": "夹在下巴下面拉的小提琴："
    },
    {
     "en": "violin"
    }
   ]
  },
  {
   "cue": [
    "show:guitar",
    "edge:concert>guitar",
    "focus:guitar"
   ],
   "parts": [
    {
     "zh": "抱在怀里弹的吉他："
    },
    {
     "en": "guitar"
    },
    {
     "zh": "小提示：开头的 g u，只读 g。"
    }
   ]
  },
  {
   "cue": [
    "show:drum",
    "edge:concert>drum",
    "focus:drum"
   ],
   "parts": [
    {
     "zh": "咚咚咚，敲起来的鼓："
    },
    {
     "en": "drum"
    }
   ]
  },
  {
   "cue": [
    "focus:piano,violin,guitar,drum"
   ],
   "parts": [
    {
     "zh": "弹钢琴、拉小提琴、弹吉他、打鼓，英语里都用同一个词 play："
    },
    {
     "en": "play the piano",
     "cue": [
      "focus:piano"
     ]
    },
    {
     "en": "play the violin",
     "cue": [
      "focus:violin"
     ]
    },
    {
