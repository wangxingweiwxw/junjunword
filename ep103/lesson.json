   ],
   "parts": [
    {
     "zh": "小朋友们好！上网可以查资料、看新闻。今天，我们来学和互联网有关的单词。"
    },
    {
     "en": "Internet"
    }
   ]
  },
  {
   "cue": [
    "map",
    "show:internet",
    "focus:internet"
   ],
   "parts": [
    {
     "zh": "连接全世界电脑的网络，是互联网："
    },
    {
     "en": "Internet"
    },
    {
     "zh": "它的开头要大写哦。"
    }
   ]
  },
  {
   "cue": [
    "show:introduction",
    "edge:internet>introduction",
    "focus:introduction"
   ],
   "parts": [
    {
     "zh": "网站上的介绍："
    },
    {
     "en": "introduction"
    },
    {
     "zh": "自我介绍，就是 self-introduction。"
    }
   ]
  },
  {
   "cue": [
    "show:search",
    "edge:internet>search",
    "focus:search"
   ],
   "parts": [
    {
     "zh": "在网上搜索："
    },
