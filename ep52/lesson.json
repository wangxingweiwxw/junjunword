    },
    {
     "en": "air"
    },
    {
     "en": "port"
    },
    {
     "en": "airport"
    }
   ]
  },
  {
   "cue": [
    "show:flight",
    "edge:airport>flight",
    "focus:flight"
   ],
   "parts": [
    {
