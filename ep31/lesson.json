 "script": [
  {
   "cue": [
    "title"
   ],
   "parts": [
    {
     "zh": "小朋友们好！两只小狗站在一起，它们一样吗？今天，我们来学比较。"
    },
    {
     "en": "compare"
    }
   ]
  },
  {
   "cue": [
    "map",
    "show:compare",
    "focus:compare"
   ],
   "parts": [
    {
     "zh": "把两样东西放在一起，看一看哪里一样、哪里不一样，就是比较："
    },
    {
     "en": "compare"
    }
   ]
  },
  {
   "cue": [
    "show:same",
    "edge:compare>same",
    "focus:same"
   ],
   "parts": [
    {
     "zh": "长得一模一样，是相同的："
    },
    {
     "en": "same"
    },
    {
     "en": "They look the same."
    }
   ]
  },
  {
   "cue": [
    "show:different",
    "edge:compare>different",
    "focus:different"
   ],
   "parts": [
    {
     "zh": "颜色不一样，是不同的："
    },
    {
     "en": "different"
    },
    {
     "en": "They are different."
    }
   ]
  },
  {
   "cue": [
    "focus:same,different"
   ],
   "parts": [
    {
     "zh": "一样，和不一样："
    },
    {
     "en": "same",
     "cue": [
      "focus:same"
     ]
    },
    {
     "en": "different",
     "cue": [
      "focus:different"
     ]
    }
   ]
  },
  {
   "cue": [
    "show:as",
    "edge:compare>as",
    "focus:as"
   ],
   "parts": [
    {
     "zh": "说两样东西一样高、一样好，要用小词"
    },
    {
     "en": "as"
    },
    {
     "zh": "两个 as 中间夹一个词：",
     "cue": [
      "alt:as"
     ]
    },
    {
     "en": "as tall as"
    },
    {
     "en": "I am as tall as you."
    }
   ]
  },
  {
   "cue": [
    "show:good",
    "focus:good"
   ],
   "parts": [
    {
     "zh": "夸一样东西，最常说好的："
    },
    {
     "en": "good"
    },
    {
     "en": "a good book"
    }
   ]
  },
  {
   "cue": [
    "show:well",
    "edge:good>well",
    "focus:well"
   ],
   "parts": [
    {
     "zh": "说一个人把事情做得好，要换成"
    },
    {
     "en": "well"
    },
    {
     "zh": "这个词很特别，它不加 l y。"
    },
    {
     "en": "I sing well."
    },
    {
     "en": "I play guitar as well as you do.",
     "cue": [
      "focus:well,as"
     ]
    }
   ]
  },
  {
   "cue": [
    "show:bad",
    "focus:bad"
   ],
   "parts": [
