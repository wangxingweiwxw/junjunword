    {
     "en": "foot"
    },
    {
     "en": "feet",
     "cue": [
      "plural:foot"
     ]
    },
    {
     "en": "one foot, two feet."
    }
   ]
  },
  {
   "cue": [
    "focus:none"
   ],
   "parts": [
    {
     "zh": "来做个身体操吧！听到哪里，就摸一摸哪里！"
    }
   ]
  },
