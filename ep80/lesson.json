   ],
   "parts": [
    {
     "zh": "小朋友们好！今天，我们来学一组很有用的形容词，还有两个神奇的小尾巴！"
    },
    {
     "en": "adjectives"
    }
   ]
  },
  {
   "cue": [
    "map",
    "show:situation",
    "focus:situation"
   ],
   "parts": [
    {
     "zh": "事情现在的样子，是情况："
    },
    {
     "en": "situation"
    }
   ]
  },
  {
   "cue": [
    "show:condition",
    "focus:condition"
   ],
   "parts": [
    {
     "zh": "东西的状况、条件，英语是"
    },
    {
     "en": "condition"
    }
   ]
  },
  {
   "cue": [
    "show:real",
    "edge:situation>real",
    "focus:real"
   ],
   "parts": [
    {
     "zh": "真的，是"
    },
    {
     "en": "real"
    }
   ]
  },
  {
   "cue": [
    "show:fake",
    "edge:real>fake",
    "focus:fake"
   ],
   "parts": [
    {
     "zh": "假的，是"
    },
    {
     "en": "fake"
    },
    {
     "en": "Is it real or fake?",
     "cue": [
      "focus:real,fake"
     ]
    }
   ]
  },
  {
   "cue": [
    "show:exciting",
    "edge:situation>exciting",
    "focus:exciting"
   ],
   "parts": [
    {
     "zh": "坐过山车，好刺激！令人兴奋的："
    },
    {
     "en": "exciting"
    }
   ]
  },
  {
   "cue": [
    "show:boring",
    "edge:exciting>boring",
    "focus:boring"
   ],
   "parts": [
    {
     "zh": "一直等啊等，好无聊："
    },
    {
     "en": "boring"
    },
    {
     "zh": "还记得第三十九集的 excited 吗？e d 说人的感受，i n g 说事情的样子。"
    }
   ]
  },
  {
   "cue": [
    "show:amazing",
    "edge:condition>amazing",
    "focus:amazing"
   ],
   "parts": [
    {
     "zh": "让人吃惊得张大嘴巴，是令人惊奇的："
    },
    {
     "en": "amazing"
    }
   ]
  },
  {
   "cue": [
    "show:fantastic",
    "edge:amazing>fantastic",
    "focus:fantastic"
   ],
   "parts": [
    {
     "zh": "太棒了，极好的："
    },
    {
     "en": "fantastic"
    }
   ]
  },
  {
   "cue": [
    "show:excellent",
    "edge:fantastic>excellent",
    "focus:excellent"
   ],
   "parts": [
    {
     "zh": "特别优秀的："
    },
    {
     "en": "excellent"
    },
    {
     "en": "Excellent work!"
    }
   ]
  },
  {
   "cue": [
    "focus:none"
   ],
   "parts": [
    {
     "zh": "下面是两个神奇的小尾巴。f u l 表示有、充满；l e s s 表示没有。"
    }
   ]
  },
  {
   "cue": [
    "show:useful",
    "focus:useful"
   ],
   "parts": [
    {
     "zh": "用，加上 f u l，是有用的："
    },
    {
     "en": "use"
    },
    {
     "en": "useful"
    }
   ]
  },
  {
   "cue": [
    "show:useless",
    "edge:useful>useless",
    "focus:useless"
   ],
   "parts": [
    {
     "zh": "换成 l e s s，就是没用的："
    },
    {
     "en": "useless"
    }
   ]
  },
  {
   "cue": [
    "show:harmful",
    "focus:harmful"
   ],
   "parts": [
    {
     "zh": "伤害，加上 f u l，是有害的："
    },
    {
     "en": "harm"
    },
    {
     "en": "harmful"
    },
    {
     "en": "Smoking is harmful."
    }
   ]
  },
  {
   "cue": [
    "show:harmless",
    "edge:harmful>harmless",
    "focus:harmless"
   ],
   "parts": [
    {
     "zh": "换成 l e s s，就是无害的："
    },
    {
     "en": "harmless"
    }
   ]
  },
  {
   "cue": [
    "focus:useful,useless,harmful,harmless"
   ],
   "parts": [
    {
     "zh": "一起读："
    },
    {
     "en": "useful, useless",
     "cue": [
      "focus:useful,useless"
     ]
    },
    {
     "en": "harmful, harmless",
     "cue": [
      "focus:harmful,harmless"
     ]
    },
    {
     "zh": "小提示：要说没用的、无害的，用 less，不说 unuseful、unharmful 哦。"
