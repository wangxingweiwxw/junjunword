   "parts": [
    {
     "zh": "我们周围的空气、水、山林，是环境："
    },
    {
     "en": "environment"
    }
   ]
  },
  {
   "cue": [
    "show:protection",
    "edge:protection>environment",
    "focus:protection"
   ],
   "parts": [
    {
     "zh": "我们要保护环境。保护是 protect，加上 i o n："
    },
