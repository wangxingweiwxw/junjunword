  },
  {
   "cue": [
    "map",
    "show:size",
    "focus:size"
   ],
   "parts": [
    {
     "zh": "动物有大有小。大小、尺寸，英语是"
    },
    {
     "en": "size"
    }
   ]
  },
  {
   "cue": [
    "show:big",
    "edge:size>big",
    "focus:big"
   ],
   "parts": [
    {
     "zh": "大象很大："
    },
    {
     "en": "big"
    },
    {
     "en": "Elephants are big."
    }
   ]
  },
  {
   "cue": [
    "show:small",
    "edge:size>small",
    "focus:small"
   ],
   "parts": [
    {
     "zh": "老鼠很小："
    },
    {
     "en": "small"
    },
    {
     "en": "Mice are small."
    },
    {
     "zh": "还记得第四十五集学过的 mice 吗？"
    }
