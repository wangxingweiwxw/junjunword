   "parts": [
    {
     "zh": "小朋友们好！数学课开始啦！今天，我们用英语来算一算。"
    },
    {
     "en": "maths"
    }
   ]
  },
  {
   "cue": [
    "map",
    "show:thousand",
    "focus:thousand"
   ],
   "parts": [
    {
     "zh": "还记得第二十三集的一百吗？十个一百，就是一千："
    },
    {
     "en": "thousand"
    },
    {
     "en": "one thousand"
    }
   ]
  },
  {
   "cue": [
    "show:million",
    "edge:thousand>million",
    "focus:million"
   ],
   "parts": [
    {
     "zh": "一千个一千，就是一百万："
    },
    {
     "en": "million"
    },
    {
     "en": "one million"
    }
   ]
  },
  {
   "cue": [
    "show:about",
    "edge:million>about",
    "focus:about"
   ],
   "parts": [
    {
     "zh": "九百九十九乘以九百九十九，大约是一百万。大约，英语是"
