  },
  {
   "cue": [
    "show:complete",
    "edge:homework>complete",
    "focus:complete"
   ],
   "parts": [
    {
     "zh": "作业写完了，每一题都打上勾，就是完成："
    },
    {
     "en": "complete"
    },
    {
     "en": "I complete my homework."
    }
   ]
  },
  {
   "cue": [
    "show:classmate",
    "edge:class>classmate",
    "focus:classmate"
   ],
   "parts": [
    {
     "zh": "和你在同一个班的小伙伴，是同学。班级，加上表示伙伴的小词"
    },
    {
     "en": "mate"
    },
    {
     "zh": "就是"
    },
    {
     "en": "classmate"
    },
    {
     "en": "She is my classmate."
    }
