 "script": [
  {
   "cue": [
    "title"
   ],
   "parts": [
    {
     "zh": "小朋友们好！今天，我们一起走进学校。"
    },
    {
     "en": "school"
    },
    {
     "zh": "学校。"
    }
   ]
  },
  {
   "cue": [
    "map",
    "show:school",
    "focus:school"
   ],
   "parts": [
    {
     "zh": "每天背着书包去上学的地方，就是学校："
    },
    {
     "en": "school"
    },
    {
     "en": "I go to school."
    }
   ]
  },
  {
   "cue": [
    "show:class",
    "edge:school>class",
    "focus:class"
   ],
   "parts": [
    {
     "zh": "学校里，同学们分成一个一个班，坐在一起上课。班级和课，英语都可以说"
    },
    {
     "en": "class"
    },
    {
     "en": "We have an English class."
    }
   ]
  },
  {
   "cue": [
    "show:teach",
    "edge:teach>class",
    "focus:teach"
   ],
   "parts": [
    {
     "zh": "站在讲台前给我们讲课，就是教："
    },
    {
     "en": "teach"
    },
    {
     "zh": "在后面加上 e r，就变成了教书的人，老师：",
     "cue": [
      "alt:teach"
     ]
    },
    {
     "en": "teacher"
    }
   ]
  },
  {
   "cue": [
    "show:work",
    "focus:work"
   ],
   "parts": [
    {
     "zh": "爸爸妈妈每天上班工作。工作，英语是"
    },
    {
     "en": "work"
    },
    {
     "en": "Mom goes to work."
    }
   ]
  },
  {
   "cue": [
    "show:schoolwork",
    "edge:school>schoolwork",
    "edge:work>schoolwork",
    "focus:schoolwork"
   ],
   "parts": [
    {
     "zh": "把学校和工作拼在一起，就是我们在学校里要做的功课："
    },
    {
     "en": "school",
     "cue": [
      "focus:school"
     ]
    },
    {
     "en": "work",
     "cue": [
      "focus:work"
     ]
    },
    {
     "en": "schoolwork",
     "cue": [
      "focus:schoolwork"
     ]
    }
   ]
  },
  {
   "cue": [
    "show:homework",
    "edge:work>homework",
    "focus:homework"
   ],
   "parts": [
    {
     "zh": "还记得上一集的家吗？家加上工作，就是要带回家做的家庭作业："
    },
    {
     "en": "home"
    },
    {
     "en": "work"
    },
    {
     "en": "homework"
    },
    {
     "en": "I do my homework."
    }
