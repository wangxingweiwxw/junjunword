    "show:throw",
    "edge:baseball>throw",
    "focus:throw"
   ],
   "parts": [
    {
     "zh": "打棒球，先要把球用力扔出去："
    },
    {
     "en": "throw"
    },
    {
     "en": "Throw the ball!"
    }
   ]
  },
  {
   "cue": [
    "show:hit",
    "edge:baseball>hit",
    "focus:hit"
   ],
   "parts": [
    {
