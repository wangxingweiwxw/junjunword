   ],
   "parts": [
    {
     "zh": "小朋友们好！学校要举行运动会啦！今天，我们来学和比赛有关的单词。"
    },
    {
     "en": "competition"
    }
   ]
  },
  {
   "cue": [
    "map",
    "show:activity",
    "focus:activity"
   ],
   "parts": [
    {
     "zh": "学校组织的各种活动："
    },
    {
     "en": "activity"
    },
    {
     "en": "school activities"
    }
   ]
  },
  {
   "cue": [
    "show:competition",
    "edge:activity>competition",
    "focus:competition"
   ],
   "parts": [
    {
     "zh": "大家比一比，谁最厉害，是比赛、竞赛："
