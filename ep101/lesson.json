   ],
   "parts": [
    {
     "zh": "小朋友们好！每天晚上，爸爸都要看新闻。今天，我们来学和新闻有关的单词。"
    },
    {
     "en": "news"
    }
   ]
  },
  {
   "cue": [
    "map",
    "show:news",
    "focus:news"
   ],
   "parts": [
    {
     "zh": "新闻，英语是"
    },
    {
     "en": "news"
    },
    {
     "zh": "它虽然有 s，却只当一件事来说哦。"
    },
    {
     "en": "The news is on TV."
    }
   ]
  },
  {
   "cue": [
    "show:information",
    "edge:news>information",
    "focus:information"
   ],
   "parts": [
    {
     "zh": "新闻告诉我们很多信息："
    },
    {
     "en": "information"
    },
    {
     "zh": "信息也不能数，不加 s。"
    }
   ]
  },
  {
   "cue": [
    "show:interesting",
    "edge:information>interesting",
    "focus:interesting"
   ],
   "parts": [
    {
     "zh": "有趣的，英语是"
    },
    {
     "en": "interesting"
    },
    {
     "en": "This is interesting news."
