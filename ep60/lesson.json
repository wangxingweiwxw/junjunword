   ],
   "parts": [
    {
     "zh": "小朋友们好！一年有十二个月。今天，我们来学月份！"
    },
    {
     "en": "months"
    }
   ]
  },
  {
   "cue": [
    "map",
    "show:month",
    "focus:month"
   ],
   "parts": [
    {
     "zh": "一个月，英语是"
    },
    {
     "en": "month"
    },
    {
     "en": "twelve months in a year"
    },
    {
     "zh": "小提示：每个月份的名字，开头都要大写。"
    }
   ]
  },
  {
   "cue": [
    "show:january",
    "edge:month>january",
    "focus:january"
   ],
   "parts": [
    {
     "zh": "新年的第一个月，一月："
    },
    {
     "en": "January"
    }
   ]
  },
  {
   "cue": [
    "show:february",
    "edge:january>february",
    "focus:february"
   ],
   "parts": [
    {
     "zh": "二月，中间的第一个 r 常常读得很轻："
    },
    {
     "en": "February"
    }
   ]
  },
  {
   "cue": [
    "show:march",
    "edge:february>march",
    "focus:march"
   ],
   "parts": [
    {
     "zh": "三月，春天来了："
    },
    {
     "en": "March"
    }
   ]
  },
  {
   "cue": [
    "show:april",
    "edge:march>april",
    "focus:april"
   ],
   "parts": [
    {
     "zh": "四月，常常下小雨："
    },
    {
     "en": "April"
    }
