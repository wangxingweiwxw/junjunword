    {
     "zh": "还记得第二十二集的朋友 friend 吗？加上 s h i p，就是友谊："
    },
    {
     "en": "friend"
    },
    {
     "en": "friendship"
    }
   ]
  },
  {
   "cue": [
    "show:conversation",
    "edge:friendship>conversation",
    "focus:conversation"
   ],
   "parts": [
    {
     "zh": "好朋友之间，有说不完的对话："
    },
    {
     "en": "conversation"
    }
   ]
  },
  {
   "cue": [
    "show:secret",
    "edge:conversation>secret",
    "focus:secret"
   ],
   "parts": [
    {
     "zh": "还会分享小秘密："
    },
    {
     "en": "secret"
    },
    {
     "en": "It's a secret!"
