 "script": [
  {
   "cue": [
    "title"
   ],
   "parts": [
    {
     "zh": "小朋友们好！肚子咕咕叫了吗？今天，我们来学好吃的。"
    },
    {
     "en": "food"
    },
    {
     "zh": "食物。"
    }
   ]
  },
  {
   "cue": [
    "map",
    "show:hungry",
    "focus:hungry"
   ],
   "parts": [
    {
     "zh": "到了中午，肚子咕咕叫，那是饿了："
    },
    {
     "en": "hungry"
    },
    {
     "en": "I'm hungry!"
    }
   ]
  },
  {
   "cue": [
    "show:eat",
    "edge:hungry>eat",
    "focus:eat"
   ],
   "parts": [
    {
     "zh": "饿了，就要吃东西："
    },
    {
     "en": "eat"
    },
    {
     "en": "Let's eat!"
    }
   ]
  },
  {
   "cue": [
    "show:food",
    "edge:eat>food",
    "focus:food"
   ],
   "parts": [
    {
     "zh": "能吃的东西，统统叫食物："
    },
    {
     "en": "food"
    },
    {
     "zh": "小提示：中间是两个字母 o。"
    },
    {
     "en": "I like Chinese food."
    }
   ]
  },
  {
   "cue": [
    "show:meal",
    "edge:eat>meal",
    "focus:meal"
   ],
   "parts": [
    {
     "zh": "早饭、午饭、晚饭，每一顿饭，叫"
    },
    {
     "en": "meal"
    },
    {
     "zh": "一天要吃三顿饭：",
     "cue": [
      "plural:meal"
     ]
    },
    {
     "en": "three meals a day"
    }
   ]
  },
  {
   "cue": [
    "show:rice",
    "edge:food>rice",
    "focus:rice"
   ],
   "parts": [
    {
     "zh": "中国小朋友天天都吃的主食，是米饭："
    },
    {
     "en": "rice"
    },
    {
     "en": "a bowl of rice"
    }
   ]
  },
  {
   "cue": [
    "show:meat",
    "edge:food>meat",
    "focus:meat"
   ],
   "parts": [
    {
     "zh": "很多小朋友最爱吃肉："
    },
    {
     "en": "meat"
    }
   ]
  },
  {
   "cue": [
    "show:chicken",
    "edge:meat>chicken",
    "focus:chicken"
   ],
   "parts": [
    {
     "zh": "鸡肉，英语是"
    },
    {
     "en": "chicken"
    },
    {
     "zh": "鸡和鸡肉，是同一个词。"
    },
    {
     "en": "I love chicken."
    }
   ]
  },
  {
   "cue": [
    "show:pork",
    "edge:meat>pork",
    "focus:pork"
   ],
   "parts": [
    {
     "zh": "猪肉可就不一样了。猪是",
     "cue": [
      "alt:pork"
     ]
    },
    {
     "en": "pig"
    },
    {
     "zh": "猪肉，却叫"
    },
    {
     "en": "pork"
    }
   ]
  },
  {
   "cue": [
    "show:beef",
    "edge:meat>beef",
    "focus:beef"
   ],
   "parts": [
    {
