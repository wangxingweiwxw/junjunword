 "script": [
  {
   "cue": [
    "title"
   ],
   "parts": [
    {
     "zh": "小朋友们好！一年有四个季节，每个季节，我们都穿不一样的衣服。"
    },
    {
     "en": "seasons"
    },
    {
     "zh": "季节。"
    }
   ]
  },
  {
   "cue": [
    "map",
    "show:season",
    "focus:season"
   ],
   "parts": [
    {
     "zh": "春、夏、秋、冬，都叫季节："
    },
    {
     "en": "season"
    },
    {
     "zh": "一年有四个季节：",
     "cue": [
      "plural:season"
     ]
    },
    {
     "en": "four seasons"
    }
   ]
  },
  {
   "cue": [
    "show:spring",
    "edge:season>spring",
    "focus:spring"
   ],
   "parts": [
    {
     "zh": "小草发芽，花儿开放，春天来了："
    },
    {
     "en": "spring"
    },
    {
     "en": "in spring"
    }
   ]
  },
  {
   "cue": [
    "show:dress",
    "edge:spring>dress",
    "focus:dress"
   ],
   "parts": [
    {
     "zh": "春天暖洋洋的，女孩子可以穿上漂亮的连衣裙："
    },
    {
     "en": "dress"
    }
   ]
  },
  {
   "cue": [
    "show:skirt",
    "edge:spring>skirt",
    "focus:skirt"
   ],
   "parts": [
    {
     "zh": "或者穿一条短短的裙子："
    },
    {
     "en": "skirt"
    },
    {
     "zh": "连衣裙上下连在一起；短裙只穿在下半身。"
    },
    {
     "en": "dress",
     "cue": [
      "focus:dress"
     ]
    },
    {
     "en": "skirt",
     "cue": [
      "focus:skirt"
     ]
    }
   ]
  },
  {
   "cue": [
    "show:summer",
    "edge:season>summer",
    "focus:summer"
   ],
   "parts": [
    {
     "zh": "太阳火辣辣，知了叫不停，夏天到了："
    },
    {
     "en": "summer"
    },
    {
     "en": "in summer"
    }
   ]
  },
  {
   "cue": [
    "show:shorts",
    "edge:summer>shorts",
    "focus:shorts"
   ],
   "parts": [
    {
     "zh": "夏天好热，穿上凉快的短裤："
    },
    {
     "en": "shorts"
    },
    {
     "zh": "短裤有两条裤腿，所以和第十集的长裤一样，总是带着 s。"
    }
   ]
  },
  {
   "cue": [
    "show:pocket",
    "edge:shorts>pocket",
    "focus:pocket"
   ],
   "parts": [
    {
     "zh": "短裤上还有口袋，可以装小东西："
    },
    {
     "en": "pocket"
    },
    {
     "en": "What's in your pocket?"
    }
   ]
  },
  {
   "cue": [
    "show:autumn",
    "edge:season>autumn",
    "focus:autumn"
   ],
   "parts": [
    {
     "zh": "树叶变黄，一片片落下来，秋天到了："
    },
    {
     "en": "autumn"
    },
    {
     "zh": "美国人还管秋天叫",
     "cue": [
      "alt:autumn"
     ]
    },
    {
     "en": "fall"
    },
    {
     "zh": "还记得第九集吗？这个词也是落下的意思，树叶落下来，就是秋天。"
    }
   ]
  },
  {
   "cue": [
    "show:jacket",
    "edge:autumn>jacket",
    "focus:jacket"
   ],
   "parts": [
    {
     "zh": "秋天凉凉的，穿上一件夹克："
    },
    {
     "en": "jacket"
    }
   ]
  },
  {
   "cue": [
    "show:jeans",
    "edge:autumn>jeans",
    "focus:jeans"
   ],
   "parts": [
    {
     "zh": "再配一条蓝色的牛仔裤："
    },
    {
     "en": "jeans"
    },
    {
     "zh": "它也总是带着 s。"
    }
   ]
  },
  {
   "cue": [
    "show:winter",
    "edge:season>winter",
    "focus:winter"
   ],
   "parts": [
    {
     "zh": "下雪啦，可以堆雪人了，冬天到了："
    },
    {
     "en": "winter"
    },
    {
     "en": "in winter"
    }
   ]
  },
  {
   "cue": [
    "show:sweater",
    "edge:winter>sweater",
    "focus:sweater"
   ],
   "parts": [
    {
     "zh": "冬天好冷，要穿上暖和的毛衣："
    },
    {
     "en": "sweater"
    },
    {
     "zh": "中间的 e a，在这里读短短的 e。"
    },
    {
     "en": "In winter, I wear a sweater."
    }
   ]
  },
  {
   "cue": [
    "show:coat",
    "edge:winter>coat",
    "focus:coat"
   ],
   "parts": [
    {
     "zh": "出门的时候，外面还要再穿一件厚厚的大衣："
    },
    {
     "en": "coat"
    }
   ]
  },
  {
   "cue": [
    "show:also",
    "edge:also>season",
    "focus:also"
   ],
   "parts": [
    {
     "zh": "我穿了毛衣，也穿了大衣。也，英语是"
    },
    {
     "en": "also"
    },
    {
     "en": "I also wear a coat.",
     "cue": [
      "focus:also,coat"
