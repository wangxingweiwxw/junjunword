    {
     "en": "country"
    }
   ]
  },
  {
   "cue": [
    "show:public",
    "focus:public"
   ],
   "parts": [
    {
     "zh": "还记得第八十三集的公共的吗？"
    },
    {
     "en": "public"
    }
   ]
  },
  {
   "cue": [
    "show:republic",
    "edge:public>republic",
    "edge:country>republic",
    "focus:republic"
   ],
   "parts": [
    {
     "zh": "共和国，英语是"
    },
    {
     "en": "republic"
    },
    {
     "zh": "仔细看，republic 里面藏着 public 哦。"
    },
    {
     "en": "the People's Republic of China"
    }
   ]
  },
  {
   "cue": [
    "show:province",
    "edge:country>province",
    "focus:province"
   ],
   "parts": [
    {
     "zh": "中国分成很多个省："
