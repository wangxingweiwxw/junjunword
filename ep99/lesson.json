   "cue": [
    "title"
   ],
   "parts": [
    {
     "zh": "小朋友们好！今天，我们来认识国家的更多知识！"
    },
    {
     "en": "country"
    }
   ]
  },
  {
   "cue": [
    "map",
    "show:country",
    "focus:country"
   ],
