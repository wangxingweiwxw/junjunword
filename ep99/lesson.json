   "parts": [
    {
     "zh": "一个国家的首都："
    },
    {
     "en": "capital"
    },
    {
     "en": "Beijing is the capital of China."
    },
    {
     "zh": "它还有一个意思，是大写字母。"
    }
   ]
  },
  {
   "cue": [
    "show:national",
    "edge:country>national",
    "focus:national"
   ],
   "parts": [
