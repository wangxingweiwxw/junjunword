  },
  {
   "cue": [
    "show:president",
    "edge:country>president",
    "focus:president"
   ],
   "parts": [
    {
     "zh": "有的国家的领导人，叫总统或主席："
    },
    {
     "en": "president"
    }
   ]
  },
  {
   "cue": [
    "show:king",
    "edge:country>king",
    "focus:king"
   ],
   "parts": [
    {
     "zh": "有的国家有国王："
    },
    {
     "en": "king"
    }
