   ],
   "parts": [
    {
     "zh": "小朋友们好！今天我们来学动作。准备好了吗？一起动起来！"
    },
    {
     "en": "action"
    },
    {
     "zh": "动作，行动。"
    }
   ]
  },
  {
   "cue": [
    "map",
    "show:action",
    "focus:action"
   ],
   "parts": [
    {
     "zh": "拍电影的时候，导演一喊这个词，演员们就开始表演啦："
    },
    {
     "en": "Action!"
    },
    {
     "zh": "它的意思，就是动作、行动。"
    },
    {
     "en": "action"
    }
   ]
  },
  {
   "cue": [
    "show:walk",
    "edge:action>walk",
    "focus:walk"
   ],
   "parts": [
    {
     "zh": "两只脚轮流向前，一步一步地走："
    },
    {
     "en": "walk"
    },
    {
     "en": "Let's walk to school."
    }
   ]
  },
  {
   "cue": [
    "show:run",
    "edge:walk>run",
    "focus:run"
   ],
   "parts": [
    {
     "zh": "走得越来越快，两只脚一起离开地面，就变成了跑："
    },
    {
     "en": "run"
    },
    {
     "en": "Run, run, run!"
    }
   ]
  },
  {
   "cue": [
    "show:stand",
    "edge:walk>stand",
    "focus:stand"
   ],
   "parts": [
    {
     "zh": "停下脚步，直直地站好："
    },
    {
     "en": "stand"
    },
    {
     "en": "Stand up, please."
    }
   ]
  },
  {
   "cue": [
    "show:sit",
    "edge:stand>sit",
    "focus:sit"
   ],
   "parts": [
    {
     "zh": "站累了，找一把椅子坐下来："
    },
    {
     "en": "sit"
    },
    {
     "en": "Sit down, please."
    }
   ]
  },
  {
   "cue": [
    "focus:stand,sit"
   ],
   "parts": [
    {
     "zh": "站起来，是"
    },
    {
     "en": "stand up",
     "cue": [
      "focus:stand"
     ]
    },
    {
     "zh": "坐下去，是",
     "cue": [
      "focus:sit"
     ]
    },
    {
     "en": "sit down"
