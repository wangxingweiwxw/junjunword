 "script": [
  {
   "cue": [
    "title"
   ],
   "parts": [
    {
     "zh": "小朋友们好！你喜欢小动物吗？今天，我们来学动物和宠物。"
    },
    {
     "en": "animals"
    }
   ]
  },
  {
   "cue": [
    "map",
    "show:animal",
    "focus:animal"
   ],
   "parts": [
    {
     "zh": "会跑、会跳、会飞的生物，都是动物："
    },
    {
     "en": "animal"
    },
    {
     "zh": "很多动物：",
     "cue": [
      "plural:animal"
     ]
    },
    {
     "en": "animals"
    }
   ]
  },
  {
   "cue": [
    "show:wild",
    "edge:wild>animal",
    "focus:wild"
   ],
   "parts": [
    {
     "zh": "住在森林、草原里，没人养的，是野生的："
    },
    {
     "en": "wild"
    },
    {
     "en": "wild animals"
    }
   ]
  },
  {
   "cue": [
    "show:pet",
    "edge:animal>pet",
    "focus:pet"
   ],
   "parts": [
    {
     "zh": "养在家里的，是宠物："
    },
    {
     "en": "pet"
    },
    {
     "en": "Do you have a pet?"
    }
   ]
  },
  {
   "cue": [
    "show:care",
    "edge:pet>care",
    "focus:care"
   ],
   "parts": [
    {
     "zh": "养宠物，要好好照顾它："
    },
    {
     "en": "care"
    },
    {
     "zh": "常常这样说：",
     "cue": [
      "alt:care"
     ]
    },
    {
     "en": "take care of my pet"
    }
   ]
  },
  {
   "cue": [
    "show:dog",
    "edge:pet>dog",
    "focus:dog"
   ],
   "parts": [
    {
     "zh": "最常见的宠物，是狗："
    },
    {
     "en": "dog"
    }
   ]
  },
  {
   "cue": [
    "show:cat",
    "edge:dog>cat",
    "focus:cat"
   ],
   "parts": [
    {
     "zh": "还有猫："
    },
    {
     "en": "cat"
    },
    {
     "en": "Cats and dogs are pets."
    }
   ]
  },
  {
   "cue": [
    "show:usual",
    "focus:usual"
   ],
   "parts": [
    {
     "zh": "猫和狗当宠物，是很平常的事。平常的，英语是"
    },
    {
     "en": "usual"
    }
   ]
  },
  {
   "cue": [
    "show:unusual",
    "edge:usual>unusual",
    "focus:unusual"
   ],
   "parts": [
    {
     "zh": "前面加上 u n，意思就反过来了，不寻常的："
    },
    {
     "en": "unusual"
    },
    {
     "en": "usual",
     "cue": [
      "focus:usual"
     ]
    },
    {
     "en": "unusual",
     "cue": [
      "focus:unusual"
     ]
    }
   ]
  },
  {
   "cue": [
    "show:snake",
    "edge:unusual>snake",
    "focus:snake"
   ],
   "parts": [
    {
     "zh": "有人养蛇当宠物，那可真不寻常："
    },
    {
     "en": "snake"
    }
   ]
  },
  {
   "cue": [
    "show:mouse",
    "edge:unusual>mouse",
    "focus:mouse"
   ],
   "parts": [
    {
     "zh": "还有人养小老鼠："
    },
    {
     "en": "mouse"
    },
    {
     "zh": "很多只老鼠，不加 s，而是变成",
     "cue": [
      "plural:mouse"
     ]
    },
    {
     "en": "mice"
    }
   ]
  },
  {
   "cue": [
    "show:bird",
    "edge:cat>bird",
    "focus:bird"
   ],
   "parts": [
    {
     "zh": "叽叽喳喳的鸟，也可以当宠物："
    },
    {
     "en": "bird"
    }
   ]
  },
  {
   "cue": [
    "show:wing",
    "edge:bird>wing",
    "focus:wing"
   ],
   "parts": [
    {
     "zh": "鸟有一对翅膀："
    },
    {
     "en": "wing"
    },
    {
     "zh": "两只翅膀：",
     "cue": [
      "plural:wing"
     ]
