     ]
    }
   ]
  },
  {
   "cue": [
    "focus:white,black"
   ],
   "parts": [
    {
     "zh": "一白一黑，正好相反："
    },
    {
     "en": "white",
     "cue": [
      "focus:white"
     ]
    },
    {
     "en": "black",
     "cue": [
      "focus:black"
     ]
    }
